{
  "manifest_version": 3,
  "name": "SurfShield",
  "version": "1.0.0",
  "description": "Real-time phishing URL detection powered by Deep Learning + Machine Learning.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SurfShield"
  }
}
